# ===========================================
# Loyalshy — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Neon Database ---
DATABASE_URL="postgresql://user:pass@ep-xxx-123.eu-central-1.aws.neon.tech/loyalshy?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx-123.eu-central-1.aws.neon.tech/loyalshy?sslmode=require"

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL="https://eu1-abc-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Better Auth ---
BETTER_AUTH_SECRET="your-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# --- Super Admin (auto-promoted on registration) ---
SUPER_ADMIN_EMAIL=""
# ADMIN_EMAIL=""                           # Only for `npm run db:seed-admin` (promotes an existing user)

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""                        # Web client ID (used by webapp + token verification)
GOOGLE_CLIENT_SECRET=""                    # Web client secret (used by webapp OAuth flow)
GOOGLE_CLIENT_ID_IOS=""                    # iOS client ID (for staff app Google login verification)
GOOGLE_CLIENT_ID_ANDROID=""                # Android client ID (for staff app Google login verification)

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Trigger.dev ---
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF=""                     # Defaults to "loyalshy-app" (trigger.config.ts)

# --- Resend (Transactional Email) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- Cloudflare R2 (File Uploads) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="loyalshy"
R2_PUBLIC_URL=""

# --- Apple Wallet (Phase 3) ---
APPLE_PASS_TYPE_IDENTIFIER="pass.com.yourcompany.loyalshy"
APPLE_TEAM_IDENTIFIER=""
APPLE_PASS_CERTIFICATE=""      # Base64-encoded .pem signer certificate
APPLE_PASS_KEY=""              # Base64-encoded .pem signer key
APPLE_PASS_KEY_PASSPHRASE=""   # Passphrase for the signer key
APPLE_WWDR_CERTIFICATE=""      # Base64-encoded Apple WWDR G4 certificate
# APNS_HOST="api.sandbox.push.apple.com"   # Optional; defaults to production api.push.apple.com

# --- Google Wallet (Phase 3) ---
GOOGLE_WALLET_ISSUER_ID=""                # Issuer ID from Google Pay & Wallet Console
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY=""      # Full service account JSON key (or base64-encoded)

# --- Google Maps / Places API (New) ---
GOOGLE_MAPS_API_KEY=""                    # Address autocomplete, review business search + daily rating snapshots

NEXT_PUBLIC_DEMO_JOIN_URL=""

# --- Staff app CORS (optional) ---
NEXT_PUBLIC_STAFF_APP_ORIGINS=""          # Extra allowed origins, comma-separated (src/lib/api-cors.ts)

# --- Staff app minimum version (optional) ----
STAFF_APP_MIN_VERSION=""                  # e.g. "1.3.0" — older builds get 426 on /api/v1/auth/me and an update screen
STAFF_APP_UPDATE_URL=""                   # Optional update link override (e.g. public TestFlight link)

# --- Cron + internal callbacks ---
CRON_SECRET=""                            # Vercel cron (/api/cron/*) + Trigger.dev callbacks (/api/internal/*); SAME value on Vercel and Trigger.dev
# REVIEW_PROMPT_DELAY_SECONDS="60"        # Test hook: send review prompts N seconds after the stamp, ignoring quiet hours

# --- Sentry (optional) ---
NEXT_PUBLIC_SENTRY_DSN=""                 # Error reporting is off when unset
SENTRY_AUTH_TOKEN=""                      # Build-time source map upload; skipped when unset
SENTRY_ORG=""
SENTRY_PROJECT=""
